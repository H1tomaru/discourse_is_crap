					<td class='mainco'>
						<a>{{game.gameNAME}}</a><br>
						<span class='baga baga-{{game.CONSOLE}}'>{{game.CONSOLE}}</span>
						<span class='smaladndark minihrenvnizu'> &gt;&gt; открыть составы &lt;&lt; </span>
					</td>
					{{! PreButtonsGame }}
					{{! Buttons244 }}
