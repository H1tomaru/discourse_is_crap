	{{#if bagamdal}}
		<div class="etomudal">

			{{#if mdalready}}

				<button class="netmudal" {{action 'netmudal'}}></button>

				{{#if prezaips.guest}}
					<div class="mudalcontent mudaladdon headin3">
						<div class="bagariban">ВНИМАНИЕ</div>
						<span>Для участия в совместной покупке игр требуется <a href='/signup'>Регистрация</a></span>
					</div>
				{{/if}}

				{{#if prezaips.banned}}
					<div class="mudalcontent mudaladdon headin3">
						<div class="bagariban">ВНИМАНИЕ</div>
						<span>Запись возможна только через личное сообщение <a href='/u/MrBug'>Организатору</a></span>
					</div>
				{{/if}}

				{{#if prezaips.winrars}}
					<div class="mudalcontent headin3 prezaips">
						<div class="bagato">
							<div class="bagapi" style="background-image:url('{{prezaips.imgLINK}}')"></div>
							<h1><a>{{prezaips.gameNAME}}</a> Запись</h1>
						</div>
						<button {{action 'imgoingin'}}>Записаться на П{{pzposition}}</button><button {{action 'netmudal'}}>Закрыть</button>
					</div>
				{{/if}}

				{{#if zaips.winrars}}
					<div class="mudalcontent mudaladdon headin3">
						<span>Запись</span>
						<span>на позицию П{{pzposition}}</span>
						<div class="bagariban">{{zaips.gameNAME}}</div>
						<span>Успешно произведена!</span>
					</div>
				{{/if}}

				{{#if zaips.zaipsfail}}
					<div class="mudalcontent headin3 prezaips">
						<div class="bagato">
							<div class="bagapi" style="background-image:url('https://i.imgur.com/33FJekg.png')">Epic Fail Is Epic</div>
						</div>
					</div>
				{{/if}}

			{{else}}

				<div class="bagaspin"></div>

			{{/if}}

		</div>
	{{/if}}

	{{#if glizt.gamedb1}}
