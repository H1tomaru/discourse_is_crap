								{{#if users.PSTATUS.[2].[3]}}<div class='malabela bggr'><span>скачал</span></div>{{/if}}
							{{/if}}
						</td>
					</tr>
					{{! Users244 }}
				{{else}}
					<tr><td>Пусто</td></tr>
				{{/each}}
			</table>
			{{/if}}

		{{/each}}
		{{/if}}

		</div>
	{{/if}}

